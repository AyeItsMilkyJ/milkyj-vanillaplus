			}]
			title: "Spawners, Traps and Pressure"
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["65E1DDB986D0FBBB", "256D9C584128753E"]
			description: [
				"Listen above and below, inspect balconies and shafts, and avoid mining load-bearing-looking blocks while teammates stand underneath."
				"Build temporary safe landings before descending. Water, ladders and scaffolding are navigation tools, not signs that the intended route has failed."
				"When a map marker seems correct but the room is absent, search by level before tunnelling through the structure."
				"Mark entrances, cleared routes, dangerous branches, and exits differently. Bring spare blocks and a water bucket, retreat to a secured room when inventory fills, and never let loot pressure erase the return path."
			]
			id: "5751FFD9F9146D57"
			rewards: [{
