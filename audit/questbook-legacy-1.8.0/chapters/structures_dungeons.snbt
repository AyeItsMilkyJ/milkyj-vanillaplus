		{
			dependencies: ["3A8709849D637D3D", "1C32576EE3145E7E"]
			description: [
				"After clearing a structure, decide whether it should become a base, landmark, museum, farm, route hub or preserved ruin. Do not half-convert every interesting place."
				"If reusing it, repair dangerous terrain and add signs without erasing its identity. If leaving it, mark the completion state and remove temporary clutter."
				"The world becomes coherent when explored places receive intentional endings."
				"Mark entrances, cleared routes, dangerous branches, and exits differently. Bring spare blocks and a water bucket, retreat to a secured room when inventory fills, and never let loot pressure erase the return path."
			]
			id: "1FDF5F10CA01AE32"
			rewards: [{
				id: "60FA8B76AAFFB1BA"
				type: "xp"
				xp: 20
			}]
			subtitle: "Choose a future for the site"
